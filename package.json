{
  "name": "pcca",
  "version": "2.0.0",
  "description": "PCCA - 酷安第三方桌面客户端",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.pcca.desktop",
    "productName": "PCCA",
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "package.json"
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "PCCA-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "electron-store": "^8.1.0",
    "https-proxy-agent": "^9.0.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  }
}
